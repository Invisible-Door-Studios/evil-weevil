+#[test]
+fn a_running_diversion_is_noise_in_canonical_state_until_its_window_ends() {
+    use idaptik_core::scenario::state::DiversionState;
+
+    let (def, mut state) = fixture();
+    state.diversion = Some(DiversionState {
+        x: 430.0,
+        t: 2.0,
+        intensity: c::MOLE_SYNTH_NOISE,
+    });
+    let sources = noise_sources(&def, &state);
+    assert_eq!(sources.len(), 1);
+    assert_eq!(sources[0].x, 430.0);
+    assert_eq!(sources[0].kind, ObservationKind::UnusualNoise);
+    assert_eq!(sources[0].intensity, c::MOLE_SYNTH_NOISE);
+
+    // The pure seam alone hears it — no host-supplied `extra_noise` — so a
+    // caller reconstructing the run from a snapshot gets the answer the
+    // running seat gets.
+    let hearing = Hearing {
+        dist: c::NOISE_INVEST_DIST,
+        threshold: c::NOISE_INVEST_NOISE,
+    };
+    let heard = observations(&def, &state, 400.0, hearing, &[]);
+    assert!(
+        heard
+            .iter()
+            .any(|o| o.kind == ObservationKind::UnusualNoise && o.x == 430.0),
+        "a diversion 30 units away is audible: {heard:?}"
+    );
+
+    // The same diversion on a floor with no infrastructure at all still
+    // sounds: it is companion state, not plumbing.
+    let mut bare = def.clone();
+    bare.infra = None;
+    let mut bare_state = state.clone();
+    bare_state.infra = None;
+    assert_eq!(noise_sources(&bare, &bare_state).len(), 1);
+    assert!(
+        observations(&bare, &bare_state, 400.0, hearing, &[])
+            .iter()
+            .any(|o| o.kind == ObservationKind::UnusualNoise && o.x == 430.0)
+    );
+
+    // An expired window is silent even if a restored snapshot still carries
+    // the record.
+    state.diversion.as_mut().unwrap().t = 0.0;
+    assert!(noise_sources(&def, &state).is_empty());
+    assert!(
+        !observations(&def, &state, 400.0, hearing, &[])
+            .iter()
+            .any(|o| o.kind == ObservationKind::UnusualNoise)
+    );
+}
