+/// The room a body at world-x is judged to be in, as a [`RoomId`]: the same
+/// answer as [`room_id_at`], falling back to the last declared room and then
+/// to the empty room id when the definition declares no rooms at all. Used
+/// where an observation needs an owned room id and the definition may be
+/// degenerate.
+pub fn room_at_or_last(def: &ScenarioDefinition, x: f64) -> RoomId {
+    room_id_at(def, x)
+        .map(RoomId::from)
+        .unwrap_or_else(|| {
+            def.rooms
+                .last()
+                .map(|r| r.id.clone())
+                .unwrap_or_else(|| RoomId::from(""))
